graph allocation {
    graph [bgcolor="transparent", color="#38393b", rankdir=LR, fontname="DejaVu Sans", fontcolor="#d2dbde", labelloc=t, label="Colored Register Allocation"];
    node [shape=ellipse, style="filled,bold", fontname="DejaVu Sans", fontcolor="#f8f9fa", color="#859399", penwidth=1.8];
    edge [color="#859399", fontcolor="#d2dbde", penwidth=1.3];

    web0 [label="web0\na\nr0\n1+,2-", fillcolor="#1982d2", color="#ff8800", shape=ellipse, penwidth=3.0];
    web1 [label="web1\nb\nr1\n1+,2,3-", fillcolor="#44b86f", color="#d2dbde", shape=ellipse, penwidth=1.8];
    web2 [label="web2\nc\nr0\n2+,3,4-", fillcolor="#1982d2", color="#d2dbde", shape=ellipse, penwidth=1.8];
    web3 [label="web3\na\nr1\n3+,4-", fillcolor="#44b86f", color="#ff8800", shape=ellipse, penwidth=3.0];
    web0 -- web1;
    web1 -- web2;
    web2 -- web3;

    subgraph cluster_legend {
        label="Legend";
        fontcolor="#d2dbde";
        color="#38393b";
        style="rounded,filled";
        fillcolor="#252628";
        key_reg [label="register color", fillcolor="#1982d2", shape=ellipse];
        key_mem [label="M = memory", fillcolor="#38393b", shape=box, color="#859399"];
        key_split [label="split-derived web", fillcolor="#252628", color="#ff8800", penwidth=3.0];
    }

    note [shape=note, fillcolor="#252628", color="#ff8800", fontcolor="#d2dbde", label="splits: web0 -> web0,web3"];
}
