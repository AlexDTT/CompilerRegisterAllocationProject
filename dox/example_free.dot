graph free_example {
    layout=neato;
    overlap=false;
    node [shape=circle, style=filled, fontname="Helvetica"];
    edge [color="#333333", penwidth=1.5];

    web0 [label="web0\nr0", fillcolor="#d9efe4", color="#2f6b56"];
    web1 [label="web1\nr1", fillcolor="#d9efe4", color="#2f6b56"];
    web2 [label="web2\nM", fillcolor="#f7ead6", color="#9a6a1d"];

    web0 -- web1;
    web1 -- web2;
    web2 -- web0;

    label="Free mode: DSATUR-style choice with selective spill fallback";
    labelloc=t;
}
