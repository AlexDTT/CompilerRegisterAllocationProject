graph splitting_example {
    rankdir=LR;
    bgcolor="transparent";
    graph [fontname="Helvetica", fontcolor="#d2dbde"];
    node [shape=circle, style=filled, fontname="Helvetica", fontcolor="#f8f9fa", color="#d2dbde", penwidth=1.6];
    edge [color="#859399", penwidth=1.4];

    subgraph cluster_before {
        label="Before splitting";
        fontcolor="#d2dbde";
        color="#38393b";
        fillcolor="#252628";
        style=filled;

        a0 [label="web0\na", fillcolor="#1982d2"];
        b0 [label="web1\nb", fillcolor="#44b86f"];
        c0 [label="web2\nc", fillcolor="#f3a600"];

        a0 -- b0;
        b0 -- c0;
        c0 -- a0;
    }

    subgraph cluster_after {
        label="After splitting web0";
        fontcolor="#d2dbde";
        color="#38393b";
        fillcolor="#252628";
        style=filled;

        a1 [label="web0\na(early)", fillcolor="#1982d2", color="#ff8800", penwidth=2.4];
        b1 [label="web1\nb", fillcolor="#44b86f"];
        c1 [label="web2\nc", fillcolor="#1982d2"];
        a2 [label="web3\na(late)", fillcolor="#44b86f", color="#ff8800", penwidth=2.4];

        a1 -- b1;
        b1 -- c1;
        c1 -- a2;
    }
}
