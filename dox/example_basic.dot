graph basic_example {
    layout=neato;
    overlap=false;
    bgcolor="transparent";
    node [shape=circle, style=filled, fontname="DejaVu Sans", fontcolor="#f8f9fa", color="#859399", penwidth=1.6];
    edge [color="#859399", penwidth=1.4];

    web0 [label="web0\ni", fillcolor="#1982d2"];
    web1 [label="web1\ni", fillcolor="#44b86f"];
    web2 [label="web2\nsum", fillcolor="#f3a600"];

    web0 -- web1;
    web1 -- web2;
}
